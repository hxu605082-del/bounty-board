{
  "manifest_version": 3,
  "name": "悬赏令 Demo",
  "version": "0.3.0",
  "description": "从 Outlook 网页里挑出给钱 / 给券的邮件，排成一张悬赏令。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "悬赏令"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
