{
  "manifest_version": 3,
  "name": "Bounty Board",
  "version": "0.4.0",
  "description": "Turns your Outlook inbox into a ranked list of paid research studies, sorted by hourly rate.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bounty Board"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
